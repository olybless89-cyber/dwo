# Set these in Render → Environment tab

# Supabase PostgreSQL connection string
DATABASE_URL=postgresql://postgres:[password]@db.[project-ref].supabase.co:5432/postgres

# Random secret used to sign JWTs — generate with: openssl rand -base64 32
SESSION_SECRET=change-me-to-a-random-secret

PORT=8080
NODE_ENV=production

# Resend API key for transactional email — get one at https://resend.com
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx

# Optional: override the From address (must be a verified domain in Resend)
# EMAIL_FROM=Tesla Pro <noreply@stockinvestmentrading.com>
